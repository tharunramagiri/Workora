const docsNavLinks = PUBLIC_NAV_LINKS.map((link) => ({
  ...link,
  labelKey: `nav.${link.key}`,
}));

const localizedHead = {
  en: {
    title: "Workora docs",
    description: "Workora documentation: quickstart, machines, agents, collaboration, self-hosting, runtimes, and the security model.",
    ogDescription: "Run human and AI agent teams in one self-hosted workspace."
  },
  zh: {
    title: "Workora docs",
