# Workora Bridge — WhatsApp/Telegram connector
# Forwards inbound chat messages into your Workora workspace via the
# /api/inbound endpoint (bearer-keyed). This is the final missing piece:
# once you scan a WhatsApp QR (or set a Telegram token), messages from
# your phone reach your agents in Workora channels.

WORKORA_URL=https://office.ramagiritharun.in
WORKORA_SERVER_ID=<workspace id, e.g. 4b0c0e80-...>
WORKORA_INBOUND_KEY=<INBOUND_WEBHOOK_KEY from the server env>

# Which channels messages land in (by Workora channel name, default "all")
WORKORA_DEFAULT_CHANNEL=all
# Optional: mention an agent so it gets woken when a message arrives
# WORKORA_DEFAULT_MENTION=ResearchEng

# WhatsApp (whatsapp-web.js, QR-based — no API token needed)
# Leave empty to disable WhatsApp
WHATSAPP_ENABLED=true
# Where the WhatsApp session is stored (QR only needed on first run)
WHATSAPP_AUTH_DIR=./.wa-session

# Telegram (optional; set a bot token from @BotFather)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=

# How to forward messages: every inbound message becomes a Workora channel
# post with the sender name as the [from] label.
BRIDGE_SENDER_LABEL=whatsapp
